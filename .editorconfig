root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# CHESSDROID_AUDIT.md §6.4 asked for this file; kept deliberately minimal. The codebase
# mixes file-scoped namespaces (newer files, tests) and block-scoped namespaces (most of
# the original App/Core code) — not worth a mechanical, behavior-risk-free-but-huge-diff
# pass to unify that, so this doesn't enforce either style.
[*.{json,md,yml,yaml}]
indent_style = space
indent_size = 2
