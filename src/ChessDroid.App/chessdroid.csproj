<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>chessdroid.ico</ApplicationIcon>
    <Copyright>ARWAN</Copyright>
    <Description>Offline chess analysis application by ARWAN</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="chessdroid.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Backup_*\**" />
    <EmbeddedResource Remove="Backup_*\**" />
    <None Remove="Backup_*\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="nul" />
  </ItemGroup>

  <!-- Copy Books folder to output -->
  <ItemGroup>
    <None Include="Books\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy piece set templates to output -->
  <ItemGroup>
    <None Include="Templates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy sound effects to output -->
  <ItemGroup>
    <None Include="Audio\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="Engines\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy drill PGN files to output -->
  <ItemGroup>
    <None Include="Drills\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Copy the Lichess puzzle CSV database to output, if present. Puzzles/ is .gitignore'd
    (the files are tens of MB each, not committed): drop your own CSVs into
    src/ChessDroid.App/Puzzles/ and they'll be picked up by every build from here on, same
    as Books/Templates/Drills/Audio/Engines above. Unlike those, this one was never wired up,
    so a fresh checkout + build previously had no Puzzle Training button at all even with the
    files sitting in the right folder.
  -->
  <ItemGroup>
    <None Include="Puzzles\**\*.*" Condition="Exists('Puzzles')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChessDroid.Core\ChessDroid.Core.csproj" />
  </ItemGroup>

</Project>